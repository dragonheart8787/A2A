{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ai-governance/contract-spec.json",
  "title": "Contract Spec Block (spec:contract v1)",
  "type": "object",
  "required": ["project", "scope", "invariants", "gates_required", "workflow_required", "change_log_required"],
  "properties": {
    "project": { "type": "string", "minLength": 1 },
    "version": { "type": "string" },
    "scope": {
      "type": "object",
      "required": ["in", "out"],
      "properties": {
        "in": { "type": "array", "items": { "type": "string" } },
        "out": { "type": "array", "items": { "type": "string" } }
      }
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "rule"],
        "properties": {
          "id": { "type": "string", "pattern": "^INV-[A-Z0-9-]+$" },
          "rule": { "type": "string" }
        }
      }
    },
    "gates_required": { "type": "boolean" },
    "workflow_required": { "type": "boolean" },
    "change_log_required": { "type": "boolean" }
  },
  "additionalProperties": true
}
